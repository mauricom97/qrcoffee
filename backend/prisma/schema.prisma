generator client {
  provider = "prisma-client-js"
  output   = "../src/infrastructure/prisma/generated"
}

datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

model Product {
  uuid        String      @id @default(uuid())
  name        String
  price       Float
  active      Boolean     @default(true)
  description String

  categoryUuid String
  category     Category   @relation(fields: [categoryUuid], references: [uuid])
  orderItems   OrderItem[]

  @@index([categoryUuid])
}

model Category {
  uuid     String    @id @default(uuid())
  name     String
  products Product[]
}

model Table {
  uuid        String  @id @default(uuid())
  number      Int     @unique
  qrCode      String  @default("")
  description String  @default("")
  orders      Order[]
}

model Order {
  uuid      String      @id @default(uuid())
  tableUuid String
  table     Table       @relation(fields: [tableUuid], references: [uuid])
  status    String      @default("PENDING") // PENDING | PREPARING | READY | DELIVERED
  createdAt DateTime    @default(now())
  items     OrderItem[]

  @@index([tableUuid])
  @@index([status])
}

model OrderItem {
  uuid       String  @id @default(uuid())
  orderUuid String
  order      Order   @relation(fields: [orderUuid], references: [uuid], onDelete: Cascade)
  productUuid String
  product    Product @relation(fields: [productUuid], references: [uuid])
  quantity   Int
  unitPrice  Float   // preço no momento do pedido

  @@index([orderUuid])
  @@index([productUuid])
}
