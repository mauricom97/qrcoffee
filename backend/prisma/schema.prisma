generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

model Product {
  uuid         String   @id @default(uuid())
  name         String
  price        Float
  active       Boolean  @default(true)
  categoryUuid String
  category     Category @relation(fields: [categoryUuid], references: [uuid])
}

model Category {
  uuid     String    @id @default(uuid())
  name     String
  products Product[]
}
