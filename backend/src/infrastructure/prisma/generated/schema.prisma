generator client {
  provider = "prisma-client-js"
  output   = "../src/infrastructure/prisma/generated"
}

datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

model Product {
  uuid        String  @id @default(uuid())
  name        String
  price       Float
  active      Boolean @default(true)
  description String

  categoryUuid String
  category     Category @relation(fields: [categoryUuid], references: [uuid])

  @@index([categoryUuid])
}

model Category {
  uuid     String    @id @default(uuid())
  name     String
  products Product[]
}
