generator client {
  provider = "prisma-client-js"
  output   = "../src/infrastructure/prisma/generated"
}

datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

model Company {
  uuid            String           @id @default(uuid())
  name            String
  createdAt       DateTime         @default(now())
  users           User[]
  tables          Table[]
  categories      Category[]
  products        Product[]
  cashierSessions CashierSession[]
}

model User {
  uuid         String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  companyUuid  String
  company      Company  @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([companyUuid])
  @@index([email])
}

model Product {
  uuid        String  @id @default(uuid())
  name        String
  price       Float
  active      Boolean @default(true)
  description String

  categoryUuid String
  category     Category    @relation(fields: [categoryUuid], references: [uuid])
  companyUuid  String
  company      Company     @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  orderItems   OrderItem[]

  @@index([categoryUuid])
  @@index([companyUuid])
}

model Category {
  uuid        String    @id @default(uuid())
  name        String
  companyUuid String
  company     Company   @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  products    Product[]

  @@index([companyUuid])
}

model Table {
  uuid        String  @id @default(uuid())
  number      Int
  qrCode      String  @default("")
  description String  @default("")
  companyUuid String
  company     Company @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  orders      Order[]

  @@unique([companyUuid, number])
  @@index([companyUuid])
}

model Order {
  uuid      String      @id @default(uuid())
  tableUuid String
  table     Table       @relation(fields: [tableUuid], references: [uuid])
  status    String      @default("PENDING") // PENDING | PREPARING | READY | DELIVERED
  createdAt DateTime    @default(now())
  items     OrderItem[]

  @@index([tableUuid])
  @@index([status])
}

model OrderItem {
  uuid        String  @id @default(uuid())
  orderUuid   String
  order       Order   @relation(fields: [orderUuid], references: [uuid], onDelete: Cascade)
  productUuid String
  product     Product @relation(fields: [productUuid], references: [uuid])
  quantity    Int
  unitPrice   Float // preço no momento do pedido

  @@index([orderUuid])
  @@index([productUuid])
}

model CashierSession {
  uuid           String            @id @default(uuid())
  companyUuid    String
  company        Company           @relation(fields: [companyUuid], references: [uuid], onDelete: Cascade)
  openedAt       DateTime          @default(now())
  closedAt       DateTime?
  openingBalance Float             @default(0)
  closingBalance Float?
  status         String            @default("OPEN") // OPEN | CLOSED
  movements      CashierMovement[]

  @@index([companyUuid])
  @@index([status])
}

model CashierMovement {
  uuid        String         @id @default(uuid())
  sessionUuid String
  session     CashierSession @relation(fields: [sessionUuid], references: [uuid], onDelete: Cascade)
  type        String // REINFORCEMENT | SANGRIA
  amount      Float
  description String?
  createdAt   DateTime       @default(now())

  @@index([sessionUuid])
}
