# Copie para .env e preencha os valores.
# Backend (obrigatório para o backend subir)
DATABASE_URL=postgresql://user:password@host:5432/database?schema=public

# Frontend (opcional; padrão: API em localhost:3352, app em localhost:3000)
# NEXT_PUBLIC_BASE_API_URL=http://localhost:3352
# NEXT_PUBLIC_BASE_FRONTEND_URL=http://localhost:3000

# iFood Merchant API (MVP — opcional; simulate funciona sem isso)
# IFOOD_API_BASE_URL=https://merchant-api.ifood.com.br
# IFOOD_CLIENT_ID=
# IFOOD_CLIENT_SECRET=
# IFOOD_WEBHOOK_SECRET=

